# IBKR Connection (IB Gateway paper mode default)
# TWS paper trading uses port 7497 instead
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_MARKET_DATA_TYPE=1     # 1=live/real-time, 3=delayed, 4=delayed-frozen (needs data subscriptions)

# Optional — only for scripts/reconcile_ibkr.py on dates older than ~24h.
# Create a "Trade Confirmation" Flex Query (Client Portal -> Settings -> Flex
# Queries) and a token (Reporting -> Flex Web Service), then set both:
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=

# Strategy Config
SYMBOLS=SPY,QQQ,IWM
MAX_POSITION_SIZE=300.0
MAX_TRADES_PER_DAY=12
SIGNAL_COOLDOWN_MINUTES=30
MIN_SPREAD_COST=0.10

# Chop Guards (see docs/RETROSPECTIVE.md 2026-07-01)
ADX_SLOPE_BARS=10           # Entry requires ADX rising over last N bars (0=off)
ORB_BREAKOUT_BUFFER_PCT=0.001  # Breakout must clear ORB level by 0.1% (0=off)
VWAP_INVALIDATION_BARS=6    # Exit if price closes past VWAP N bars in a row (0=off)
                            # 3->6 on 2026-07-10: replay of 31 entries showed N=6 better
                            # (-115bp vs -151bp); N=3 whipsawed a real +46% winner (06-30 IWM).
                            # Revert triggers: 2 invalidations worse than -45%, or any
                            # hard-stop that N=3 would clearly have caught.
MAX_INVALIDATIONS_PER_SIGNAL=2  # Stand down a signal after N invalidation exits/day (0=off)
PATH_FRESH_BARS=10          # Breakout level must have been crossed within N bars (0=off)
PATH_MOMENTUM_BARS=3        # Last N closes must net-move WITH the signal (0=off)

# Conviction Sizing (score 0-5 -> budget multiplier; see docs/HOW_IT_WORKS.md)
CONVICTION_SIZING_ENABLED=true
CONVICTION_LOW_MULT=0.5     # score <= 1: $150 at MAX_POSITION_SIZE=300
CONVICTION_HIGH_MULT=1.5    # score >= 4: $450
MIN_CONVICTION_SCORE=2      # Skip entries scoring below this (LOW tier: 1W/5L, can't clear fees)

# Take-profit: resting limit sell at entry x 1.60, placed on fill (0=off)
TAKE_PROFIT_TARGET_PCT=0.60

# Iron condors — DISABLED 2026-07-10: 1W/5L, ~-$245, run over on range->trend days;
# 86% structural breakeven WR. Re-enable once the debit side is fee-adjusted-green (TODO #28).
CONDOR_ENABLED=false
CONDOR_MAX_ADX=22           # Only when trend is absent
CONDOR_MIN_VWAP_CROSSES=8   # Only when chop is proven
MIN_CONDOR_CREDIT=0.15      # Skip if total credit below this
CONDOR_TP_PCT=0.50          # Resting buy-back at 50% of credit received

# Fast exit polling (fixes exit sampling slippage; 0 disables)
FAST_POLL_SECONDS=15        # Loop cadence when an exit needs tight watching
FAST_POLL_ARM_PCT=0.35      # Start fast-polling once a trade's profit reaches this

# Risk Management
# Trailing stop only arms after the trade peaks at +50%; then exits if profit falls
# to 90% of the peak (gives back 10% of the peak; peak +50% -> exit +45%).
# Below +50% peak, only the hard stop (-70%) applies.
TAKE_PROFIT_TRAIL_TRIGGER=0.50
TRAILING_STOP_LOSS_PCT=0.10
HARD_STOP_LOSS_PCT=0.70
MAX_CONSECUTIVE_LOSSES=5
MAX_DAILY_LOSS=400          # Stop new entries once the day's realized net P&L <= -$400 (0=off)

# Force-close all open 0DTE positions at this ET time (before the 4 PM close)
EOD_FLATTEN_TIME=15:55

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1507182288306438265/-34csIICrltPxSaciixQ_cp-AbwejV-rIR1LxZ5eNpkg4U4SIRFODe9Vq-WrWfE758fi
DISCORD_BOT_TOKEN=MTUyMTM0ODI4Nzc3MTMxMjIxOA.GbfR5_.Ljko9TPzMnyv-5cty3UaGNQSRxkTJhjmEaH6v8